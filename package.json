{
  "name": "tord",
  "private": true,
  "version": "0.1.0",
  "description": "Town-level grocery and medicine delivery platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @tord/web dev",
    "dev:api": "pnpm --filter @tord/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @tord/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @tord/api prisma:generate",
    "db:migrate": "pnpm --filter @tord/api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter @tord/api prisma:migrate:deploy",
    "db:seed": "pnpm --filter @tord/api prisma:seed",
    "db:studio": "pnpm --filter @tord/api prisma:studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
