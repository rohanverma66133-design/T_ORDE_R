# Copy to .env at the repository root for local orchestration,
# and to apps/api/.env plus apps/web/.env.local for each app.

NODE_ENV=development

# Web
NEXT_PUBLIC_APP_NAME=T-Ord
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000

# API
API_PORT=3001
API_PREFIX=api/v1
API_HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://tord:tord@localhost:5433/tord?schema=public

# Redis / jobs
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace-with-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-char-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Minimum 32-character payment provider webhook signing secret
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
OTP_CODE_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=5
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=T-Ord Delivery <onboarding@resend.dev>

# Object storage (local | s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=tord-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Observability
LOG_LEVEL=info
