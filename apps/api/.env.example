NODE_ENV=development
API_PORT=3001
API_PREFIX=api/v1
API_HOST=0.0.0.0
DATABASE_URL=postgresql://tord:tord@localhost:5433/tord?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-32-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-char-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_CODE_LENGTH=6
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Test-only: never enable outside NODE_ENV=test.
ALLOW_FIXED_TEST_OTP=false
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=tord-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
